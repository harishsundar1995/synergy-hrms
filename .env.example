# Environment Variables for Synergy Well Platform

# Clerk Authentication
VITE_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key_here

# MongoDB Configuration (for backend)
MONGODB_URI=mongodb://localhost:27017/synergy-well
MONGODB_DB_NAME=synergy-well

# OpenAI Configuration (for AI features)
OPENAI_API_KEY=your_openai_api_key_here

# Backend API Configuration
VITE_API_URL=http://localhost:3001

# Application Configuration
NODE_ENV=development
PORT=3001

# Security
JWT_SECRET=your_jwt_secret_here

# External Integrations (for future phases)
LINKEDIN_CLIENT_ID=your_linkedin_client_id_here
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret_here
INDEED_API_KEY=your_indeed_api_key_here

# Webhooks
CLERK_WEBHOOK_SECRET=your_clerk_webhook_secret_here
